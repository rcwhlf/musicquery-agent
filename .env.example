# =====================================================
# 使用方法：把本文件复制一份并重命名为 .env，然后填入真实值
#   Windows 命令：copy .env.example .env
# =====================================================

# ---------- MySQL 数据库配置 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=music_query

# ---------- 大模型 API 配置（OpenAI 兼容接口） ----------
# 智谱 GLM（本项目默认，免费档小模型）：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# 智谱 GLM（更强，收费）：              LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-5.3-flash
# DeepSeek：             LLM_BASE_URL=https://api.deepseek.com               LLM_MODEL=deepseek-chat
# OpenAI：               LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o-mini
# 本地 Ollama：          LLM_BASE_URL=http://localhost:11434/v1              LLM_MODEL=qwen2.5:7b（Key 随便填）
#
# 说明：glm-4-flash 免费但能力较弱，会把"一共有多少首歌？"这类泛化问句误判为无关，
#       因此代码里加了关键词快速通道兜底（见 agent/sql_generator.py）。
#       换用 glm-5.3-flash 等更强模型可提升准确率，无需改动代码。
LLM_API_KEY=你的智谱APIKey
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
